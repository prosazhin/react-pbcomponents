{
  "name": "pbcomponents-monorepo",
  "version": "0.0.0",
  "description": "UI component library for React with Typescript and Tailwind",
  "main": "index.js",
  "private": true,
  "workspaces": [
    "./workspaces/*"
  ],
  "engines": {
    "node": ">=22.x"
  },
  "scripts": {
    "dev:components": "npm run --workspace=@prosazhin/pbcomponents dev",
    "dev:storybook": "npm run --workspace=pbcomponents-storybook dev",
    "dev": "npm-run-all -p dev:*",
    "build:components": "npm run --workspace=@prosazhin/pbcomponents build",
    "build:storybook": "npm run --workspace=pbcomponents-storybook build",
    "build": "npm-run-all -s build:components build:storybook",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write \"**/*.{css,js,jsx,ts,tsx,md,mdx,json}\"",
    "install-force": "npm install --force",
    "clean": "npm run clean:build --workspaces --if-present && npm run clean:modules --workspaces --if-present && rm package-lock.json && rimraf ./node_modules",
    "prepare": "npx simple-git-hooks"
  },
  "author": "Evgenii Sazhin <prosazhin@gmail.com> (https://prosazhin.ru)",
  "license": "MIT",
  "simple-git-hooks": {
    "pre-commit": "npx --no-install lint-staged --concurrent false",
    "pre-push": "npm run format",
    "commit-msg": "npx --no-install commitlint --edit ${1}"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
  "prettier": {
    "bracketSpacing": true,
    "semi": true,
    "useTabs": false,
    "trailingComma": "all",
    "printWidth": 140,
    "tabWidth": 2,
    "jsxSingleQuote": true,
    "singleQuote": true,
    "quoteProps": "as-needed",
    "arrowParens": "always",
    "endOfLine": "lf",
    "organizeImportsSkipDestructiveCodeActions": true,
    "plugins": [
      "prettier-plugin-organize-imports",
      "prettier-plugin-tailwindcss"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "dependencies": {
    "@prosazhin/pbcomponents": "*"
  },
  "overrides": {
    "postcss": "^8.5.18",
    "@vitest/browser": "^4.1.10",
    "fast-uri": "^3.1.6",
    "@microsoft/api-extractor": {
      ".": "^7.58.2",
      "lodash": "^4.18.1",
      "minimatch": "10.2.3"
    },
    "flatted": "^3.4.2",
    "vite": "^7.3.5",
    "yaml": "^2.8.3",
    "shell-quote": "^1.8.4",
    "esbuild": "^0.28.1",
    "@babel/core": "^7.29.6",
    "js-yaml": "^4.2.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "lint-staged": "^16.4.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.8.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "rimraf": "^6.1.3",
    "simple-git-hooks": "^2.13.1",
    "storybook": "^10.3.3",
    "vitest": "^4.1.6"
  }
}
